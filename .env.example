# --- Core ---
# PostgreSQL (docker-compose default). Falls back to SQLite if unset.
DATABASE_URL=postgresql+psycopg2://padforward:padforward@localhost:5432/padforward
CORS_ORIGINS=http://localhost:3000
DEMO_MODE=true

# --- Google AI (Gemini agent). App falls back to deterministic engine if unset. ---
GEMINI_API_KEY=

# --- Google Maps Platform (backend-side, optional) ---
GOOGLE_MAPS_API_KEY=

# --- Frontend (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Optional: Snowflake analytics layer ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

# --- Optional: ElevenLabs voice accessibility ---
ELEVENLABS_API_KEY=
